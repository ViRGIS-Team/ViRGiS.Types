    "m_SourceType": 1,
    "m_FunctionName": "_virgis_pattern_switch",
    "m_FunctionSource": "",
    "m_FunctionBody": "switch (Control)\n{\n\tcase 0:\n\t\tOut = In0;\n\t\treturn;\n\tcase 1:\n\t\tOut = In1;\n\t\treturn;\n\tcase 2:\n\t\tOut = In2;\n\t\treturn;\n\tcase 3:\n\t\tOut = In3;\n\t\treturn;\n\tdefault:\n\t\treturn;\n}"
}

