{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "d643d79f8496434897dc8b481e3b5011",
    "m_Group": {
        "m_Id": "c5d325f08aa049afa51e81ab3ca851d9"
    },
    "m_Name": "Extract_Vertex_Color (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": 1172.4998779296875,
            "y": -1040.0,
            "width": 273.5001220703125,
            "height": 118.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "bece3c4a5b954216aa91a550efa79d2c"
        },
        {
            "m_Id": "6165cf5fcfdd4c458af57ea32afcaaf1"
        },
        {
            "m_Id": "6d47b4a5dfda4016bcd7b1cba29ca2f4"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "Extract_Vertex_Color",
    "m_FunctionSource": "",
    "m_FunctionBody": "switch(uv.x){\n  case 1:\n    RGB = float3(1,0,0);\n    R_G_B_ = float3(0,0,0);\n    return;\n  case 2:\n    RGB = float3(0,1,0);\n    R_G_B_ = float3(0,0,0);\n    return;\n  case 3:\n    RGB = float3(0,0,1);\n    R_G_B_ = float3(0,0,0);\n    return;\n  case 4:\n    RGB = float3(1,0,0);\n    R_G_B_ = float3(1,0,0);\n    return;\n  case 5:\n    RGB = float3(0,1,0);\n    R_G_B_ = float3(0,1,0);\n    return;\n  case 6:\n    RGB = float3(0,0,1);\n    R_G_B_ = float3(0,0,1);\n    return;\n  default:\n    RGB = float3(0,0,0);\n    R_G_B_ = float3(0,0,0);\n    return;\n}"
}

